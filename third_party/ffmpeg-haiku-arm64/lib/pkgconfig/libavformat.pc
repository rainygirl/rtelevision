prefix=/root/ffmpeg-haiku-arm64
exec_prefix=${prefix}
libdir=/root/ffmpeg-haiku-arm64/lib
includedir=/root/ffmpeg-haiku-arm64/include

Name: libavformat
Description: FFmpeg container format library
Version: 60.16.100
Requires: 
Requires.private: libavcodec >= 60.31.102, libavutil >= 58.29.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lnetwork -lssl -lcrypto
Cflags: -I${includedir}
