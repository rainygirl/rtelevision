# R Television - Linux front end (GTK3 + libVLC)
#
#   make            build build/RTelevision with the vendored libVLC
#   make cli        headless tool (no GTK needed)
#   make run
#   make install    install into ~/.local (PREFIX overrides)
#   make clean
#
# libVLC is vendored by fetch-libvlc.sh into third_party/vlc-linux-<arch>, so
# the app runs without a system VLC install. Set VLC_SYSTEM=1 to link the
# distribution's libvlc instead.

SHARED_DIR := ../../shared
include $(SHARED_DIR)/common.mk

APP    := RTelevision
BUILD  := build
UI_SRC := main.cpp MainWindow.cpp
SEED   := ../../resources/seed-playlist.m3u
NOTICES := ../../LICENSE ../../THIRD-PARTY-NOTICES.md
ICON   := ../../resources/icon/icon_256.png

ARCH    := $(shell dpkg --print-architecture 2>/dev/null || uname -m)
VLC_DIR := ../../third_party/vlc-linux-$(ARCH)
PREFIX  ?= $(HOME)/.local

GTK_CFLAGS  := $(shell pkg-config --cflags gtk+-3.0 gdk-x11-3.0)
GTK_LIBS    := $(shell pkg-config --libs gtk+-3.0 gdk-x11-3.0)
CURL_CFLAGS := $(shell pkg-config --cflags libcurl)
CURL_LIBS   := $(shell pkg-config --libs libcurl)

VLC_SYSTEM ?= 0
ifeq ($(VLC_SYSTEM),1)
  VLC_CFLAGS := $(shell pkg-config --cflags libvlc)
  VLC_LIBS   := $(shell pkg-config --libs libvlc)
  VLC_DEP    :=
else
  VLC_CFLAGS := -I$(VLC_DIR)/include
  # rpath $ORIGIN/vlc/lib: the bundled libvlc travels with the binary.
  # libvlccore must be named explicitly so the linker can resolve libvlc's
  # symbols. --disable-new-dtags emits RPATH rather than RUNPATH: RUNPATH is not
  # inherited, so libvlc's own lookup of libvlccore would miss $$ORIGIN.
  VLC_LIBS   := -L$(VLC_DIR)/lib -lvlc -lvlccore \
                -Wl,-rpath,'$$ORIGIN/vlc/lib' -Wl,--disable-new-dtags
  VLC_DEP    := $(VLC_DIR)/lib/libvlc.so
endif

SRC := $(CORE_SRC) $(CORE_SRC_VLC) $(CORE_SRC_HTTP_CURL) $(UI_SRC)
OBJ := $(addprefix $(BUILD)/obj/,$(notdir $(SRC:.cpp=.o)))

CXXFLAGS := $(CORE_CXXFLAGS) -I. $(GTK_CFLAGS) $(CURL_CFLAGS) $(VLC_CFLAGS)
LIBS     := $(GTK_LIBS) $(VLC_LIBS) $(CURL_LIBS) -lpthread

VPATH := $(SHARED_DIR)/core:$(SHARED_DIR)/tools:.

.PHONY: all run install uninstall clean cli deps

all: $(BUILD)/$(APP)

deps $(VLC_DIR)/lib/libvlc.so:
	sh fetch-libvlc.sh

$(BUILD)/obj/%.o: %.cpp | $(VLC_DEP)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/$(APP): $(OBJ) | $(VLC_DEP)
	@mkdir -p $(BUILD)
	$(CXX) $(OBJ) $(LDFLAGS) $(LIBS) -o $@
	@# Lay the runtime out the way main.cpp looks for it.
	cp $(SEED) $(BUILD)/seed-playlist.m3u
	cp $(ICON) $(BUILD)/icon.png
	@# The bundled libVLC is LGPL/GPL: its notices travel with the binaries.
	cp $(NOTICES) $(BUILD)/
	@rm -rf $(BUILD)/licenses
	cp -a ../../licenses $(BUILD)/licenses
ifeq ($(VLC_SYSTEM),0)
	@mkdir -p $(BUILD)/vlc
	@rm -rf $(BUILD)/vlc/lib $(BUILD)/vlc/plugins
	cp -a $(VLC_DIR)/lib $(BUILD)/vlc/lib
	cp -a $(VLC_DIR)/plugins $(BUILD)/vlc/plugins
endif
	@echo "built: $@"

cli: $(BUILD)/rtv-cli

# The headless tool never plays anything, so it takes the null media backend.
$(BUILD)/rtv-cli: $(CORE_SRC) $(CORE_SRC_NULL) $(CORE_SRC_HTTP_CURL) $(CLI_SRC)
	@mkdir -p $(BUILD)
	$(CXX) $(CORE_CXXFLAGS) $(CURL_CFLAGS) $^ $(LDFLAGS) $(CURL_LIBS) -lpthread -o $@

run: $(BUILD)/$(APP)
	./$(BUILD)/$(APP)

install: $(BUILD)/$(APP)
	mkdir -p $(PREFIX)/bin $(PREFIX)/lib/RTelevision $(PREFIX)/share/RTelevision \
	         $(PREFIX)/share/applications
	cp $(BUILD)/$(APP) $(PREFIX)/lib/RTelevision/$(APP)
	cp $(SEED) $(PREFIX)/share/RTelevision/seed-playlist.m3u
	cp $(NOTICES) $(PREFIX)/share/RTelevision/
	rm -rf $(PREFIX)/share/RTelevision/licenses
	cp -a ../../licenses $(PREFIX)/share/RTelevision/licenses
	mkdir -p $(PREFIX)/share/icons/hicolor/256x256/apps
	cp $(ICON) $(PREFIX)/share/icons/hicolor/256x256/apps/r-television.png
ifeq ($(VLC_SYSTEM),0)
	rm -rf $(PREFIX)/lib/RTelevision/vlc
	mkdir -p $(PREFIX)/lib/RTelevision/vlc
	cp -a $(VLC_DIR)/lib $(PREFIX)/lib/RTelevision/vlc/lib
	cp -a $(VLC_DIR)/plugins $(PREFIX)/lib/RTelevision/vlc/plugins
endif
	ln -sf $(PREFIX)/lib/RTelevision/$(APP) $(PREFIX)/bin/r-television
	printf '%s\n' \
	  '[Desktop Entry]' 'Type=Application' 'Name=R Television' \
	  'Comment=iptv-org channel player' \
	  'Exec=$(PREFIX)/bin/r-television' 'Icon=r-television' \
	  'Categories=AudioVideo;Video;Player;' 'Terminal=false' \
	  > $(PREFIX)/share/applications/r-television.desktop
	@echo "installed: $(PREFIX)/bin/r-television"

uninstall:
	rm -rf $(PREFIX)/lib/RTelevision $(PREFIX)/share/RTelevision \
	       $(PREFIX)/bin/r-television $(PREFIX)/share/applications/r-television.desktop \
	       $(PREFIX)/share/icons/hicolor/256x256/apps/r-television.png

clean:
	rm -rf $(BUILD)

# Generated by -MMD: rebuild whatever a changed header touches.
-include $(OBJ:.o=.d)
