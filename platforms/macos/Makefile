# R Television - macOS front end (Cocoa + libVLC)
#
#   make                 build for the host architecture
#   make ARCHS=x86_64    build for Intel
#   make ARCHS="arm64 x86_64"   universal
#   make run             build and launch
#   make install         copy the bundle to /Applications
#   make dist            universal .dmg in dist/, for people who will not build
#   make clean

SHARED_DIR := ../../shared
include $(SHARED_DIR)/common.mk

APP_NAME  := R Television
BUNDLE_ID := org.rainygirl.rtelevision
VERSION   := 1.0.0

empty :=
space := $(empty) $(empty)

ARCHS  ?= $(shell uname -m)
BUILD  := build/$(subst $(space),-,$(ARCHS))
APP    := $(BUILD)/$(APP_NAME).app
# Directory mtimes do not track changes to nested files, so the bundle is
# tracked with a stamp instead.
STAMP  := $(BUILD)/.bundle-stamp
MACOS  := $(APP)/Contents/MacOS
RES    := $(APP)/Contents/Resources

VLC_DIR     := ../../third_party/vlc-macos
SEED        := ../../resources/seed-playlist.m3u
ICON        := ../../resources/icon/AppIcon.icns
NOTICES     := ../../LICENSE ../../THIRD-PARTY-NOTICES.md
INSTALL_DIR ?= /Applications
DIST_DIR    := dist
DMG         := $(DIST_DIR)/R-Television-$(VERSION)-macOS.dmg

UI_SRC := main.mm AppDelegate.mm BundlePaths.mm MainWindowController.mm
SRC    := $(CORE_SRC) $(CORE_SRC_VLC) $(CORE_SRC_HTTP_CURL) $(UI_SRC)
OBJ    := $(addprefix $(BUILD)/obj/,$(notdir $(SRC:.cpp=.o)))
OBJ    := $(OBJ:.mm=.o)

ARCHFLAGS := $(foreach a,$(ARCHS),-arch $(a))
CXXFLAGS  := $(CORE_CXXFLAGS) $(ARCHFLAGS) -mmacosx-version-min=11.0 -I. -I$(VLC_DIR)/include
OBJCXXFLAGS := $(CXXFLAGS) -fobjc-arc
LDFLAGS   := $(ARCHFLAGS) -mmacosx-version-min=11.0 \
             -framework Cocoa -lcurl \
             -L$(VLC_DIR)/lib -lvlc -Wl,-rpath,@executable_path/lib

VPATH := $(SHARED_DIR)/core:$(SHARED_DIR)/tools:.

.PHONY: all run install clean cli deps dist

all: $(STAMP)

# The libVLC SDK is vendored, not assumed to be installed on the machine.
deps $(VLC_DIR)/lib/libvlc.dylib:
	sh fetch-libvlc.sh

$(BUILD)/obj/%.o: %.cpp | $(VLC_DIR)/lib/libvlc.dylib
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD)/obj/%.o: %.mm | $(VLC_DIR)/lib/libvlc.dylib
	@mkdir -p $(dir $@)
	$(CXX) $(OBJCXXFLAGS) -c $< -o $@

$(STAMP): $(OBJ) Info.plist.in $(SEED) $(ICON) $(NOTICES)
	@mkdir -p "$(MACOS)" "$(RES)"
	$(CXX) $(OBJ) $(LDFLAGS) -o "$(MACOS)/$(APP_NAME)"
	sed -e 's/@EXECUTABLE@/$(APP_NAME)/' \
	    -e 's/@BUNDLE_ID@/$(BUNDLE_ID)/' \
	    -e 's/@VERSION@/$(VERSION)/' Info.plist.in > "$(APP)/Contents/Info.plist"
	cp $(SEED) "$(RES)/seed-playlist.m3u"
	cp $(ICON) "$(RES)/AppIcon.icns"
	@# The bundled libVLC is LGPL/GPL: its notices travel with the binaries.
	cp $(NOTICES) "$(RES)/"
	rm -rf "$(RES)/licenses"
	cp -R ../../licenses "$(RES)/licenses"
	@# Ship libVLC and its module tree inside the bundle: no VLC install needed.
	rm -rf "$(MACOS)/lib" "$(MACOS)/plugins"
	cp -R $(VLC_DIR)/lib "$(MACOS)/lib"
	cp -R $(VLC_DIR)/plugins "$(MACOS)/plugins"
	@# Ad-hoc signature, required for the bundle to launch on Apple Silicon.
	codesign --force --sign - --timestamp=none "$(APP)" >/dev/null 2>&1 || true
	@touch $@
	@echo
	@lipo -info "$(MACOS)/$(APP_NAME)"
	@echo "built: $(APP)"

cli: $(BUILD)/rtv-cli

# The headless tool never plays anything, so it takes the null media backend and
# needs no libVLC at runtime.
$(BUILD)/rtv-cli: $(CORE_SRC) $(CORE_SRC_NULL) $(CORE_SRC_HTTP_CURL) $(CLI_SRC)
	@mkdir -p $(BUILD)
	$(CXX) $(CORE_CXXFLAGS) $(ARCHFLAGS) -mmacosx-version-min=11.0 $^ -lcurl -o $@

run: $(STAMP)
	"$(MACOS)/$(APP_NAME)"

install: $(STAMP)
	rm -rf "$(INSTALL_DIR)/$(APP_NAME).app"
	cp -R "$(APP)" "$(INSTALL_DIR)/"
	@echo "installed: $(INSTALL_DIR)/$(APP_NAME).app"

# One disk image for both kinds of Mac: the universal bundle and a shortcut to
# /Applications to drag it onto. The bundle is only ad-hoc signed (there is no
# Developer ID to sign or notarize with), so the READMEs explain how to let
# macOS open it the first time.
dist:
	$(MAKE) ARCHS="arm64 x86_64"
	@rm -rf $(DIST_DIR)/stage
	@mkdir -p $(DIST_DIR)/stage
	ditto "build/arm64-x86_64/$(APP_NAME).app" "$(DIST_DIR)/stage/$(APP_NAME).app"
	ln -s /Applications "$(DIST_DIR)/stage/Applications"
	codesign --verify --deep --strict "$(DIST_DIR)/stage/$(APP_NAME).app"
	@rm -f "$(DMG)"
	hdiutil create -volname "$(APP_NAME)" -srcfolder $(DIST_DIR)/stage -ov -format UDZO "$(DMG)"
	@rm -rf $(DIST_DIR)/stage
	@echo "disk image: $(DMG)"

clean:
	rm -rf build $(DIST_DIR)

# Generated by -MMD: rebuild whatever a changed header touches.
-include $(OBJ:.o=.d)
