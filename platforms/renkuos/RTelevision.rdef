/* Application resources: signature, version and the vector icon.
   The icon is generated by resources/icon/make-hvif.py. */

resource app_signature "application/x-vnd.r-television";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "R Television",
	long_info  = "Free TV streams from around the world."
};

resource(101, "BEOS:ICON") #'VICN' import "../../resources/icon/RTelevision.hvif";
